    "disconnected_or_collaged_structure": "Legacy field name for the binary rater-facing Foreign patch observation."
  },
  "released_tables": {
    "human_ratings_public.csv": "One row per condition, anonymous rater, case, and method. Preference is duplicated across the two method rows belonging to the same paired trial."
